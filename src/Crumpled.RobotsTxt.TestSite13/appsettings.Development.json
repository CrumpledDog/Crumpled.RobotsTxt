{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Unattended": {
        "UpgradeUnattended": true,
        "InstallUnattended": true,
        "UnattendedUserEmail": "demo@umbraco.com",
        "UnattendedUserName": "demo",
        "UnattendedUserPassword": "1234567890"
      },      
      "Content": {
        "MacroErrors": "Throw"
      },
      "Hosting": {
        "Debug": true
      },
      "RuntimeMinification": {
        "UseInMemoryCache": true,
        "CacheBuster": "Timestamp"
      }
    }
  },
  "Crumpled": {
    "RobotsTxt": {
      //"DisableComposer": true,
      "DefaultRuleset": "NonProduction",
      "RuleSets": { // There can be multiple rulesets for complex scenarios!
        "Production": {
          "IncludeContentSignalInstructions": true,
          "ContentSignal": {
            "AiTrain": true,
            "Search": true,
            "AiInput": true
          },
          "Allow": {
            "OAI-SearchBot":{
              "Paths": [ "/" ],
              "ContentSignal": {
                "AiTrain": false,
                "Search": true,
                "AiInput": false
              }
            },
            "googlebot":{
              "Paths": [ "/blog", "/news" ],
              "ContentSignal": {
                "AiTrain": false,
                "Search": true,
                "AiInput": false
              },
              "CrawlDelay": 2
            },
            "bingbot": [
              {
                "Paths": [ "/blog", "/news" ],
                "ContentSignal": {
                  "AiTrain": true,
                  "Search": true,
                  "AiInput": false
                }
              },
              {
                "Paths": [ "/" ],
                "ContentSignal": {
                  "AiTrain": false,
                  "Search": true,
                  "AiInput": false
                }
              }
            ],
            "*" : ["/"]
          },
          "Disallow": {
            "*": [ "/cdn-cgi/challenge-platform/", "/cdn-cgi/email-platform/" ]
          }
        },
        "NonProduction": {
          "IncludeContentSignalInstructions": false,
          "Allow": {
            "SemrushBot": [ "/" ],
            "SemrushBot-SA": [ "/" ],
            "SemrushBot-Desktop": [ "/" ],
            "SemrushBot-Mobile": [ "/" ],
            "SiteAuditBot": [ "/" ]
          },
          "Disallow": {
            "*": [ "/" ]
          }
        }
      },
      "Sites": {
        "Prod": {
          "HostNames": "www.mysite.com,localhost:44390",
          "SiteMapDomain": "www.mysite.com",
          "RuleSet": "Production"
        },
        "AnotherProd": {
          "HostNames": "www.anothermysite.com",
          "SiteMapDomain": "www.anothermysite.com",
          "RuleSet": "Production" // or can define alternate production ruleset for this site
        },
        "Stage": {
          "HostNames": "mysite-staging-uksouth01.umbraco.io,staging.mysite.com,localhost:44389", 
          "SiteMapDomain": "staging.mysite.com",
          "RuleSet": "NonProduction"
        },
        "Dev": {
          "HostNames": "mysite-dev-uksouth01.umbraco.io,dev.mysite.com",
          "SiteMapDomain": "dev.mysite.com",
          "RuleSet": "NonProduction"
        }
      }
  }
  }  
}
