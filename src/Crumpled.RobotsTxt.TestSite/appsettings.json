{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "c91d7336-165a-40c0-82fc-ea7a1a866b23",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Crumpled": {
    "ReleaseInfo": {
      "Deployment": {
        "BuildRevision": "1.2.3-alpha.2332",
        "BuildBranchName": "develop",
        "CommitTimeStamp": "23232aa"
      }
    },
    "RobotsTxt": {
      //"DisableComposer": true,
      "DefaultRuleset": "Development",
      "RuleSets": {
        "Production": {
          "Allow": {
            "*" : ["/"],
            "Twitterbot": [ "/" ],
            "facebookexternalhit": [ "/" ]
          },
          "Disallow": {
            "*": [ "/cdn-cgi/challenge-platform/", "/cdn-cgi/email-platform/" ]
          }
        },
        "Development": {
          "Allow": {
            "SemrushBot": [ "/" ],
            "SemrushBot-SA": [ "/" ],
            "SemrushBot-Desktop": [ "/" ],
            "SemrushBot-Mobile": [ "/" ],
            "SiteAuditBot": [ "/" ],
            "PowerMapper": [ "/" ]
          },
          "Disallow": {
            "*": [ "/" ]
          }
        },
        "Production2": {
          "Allow": {
            "SpecialBot2": [ "/" ]
          },
          "Disallow": {
            "SpecialBot": [ "/" ],
            "*": [ "/cdn-cgi/challenge-platform/", "/cdn-cgi/email-platform/" ]
          }
        }
      },
      "Sites": {
        "Prod": {
          "HostNames": "www.mysite2.com,mysite.com,localhost:44390",
          "SiteMapDomain": "www.mysite3.com",
          "RuleSet": "Production"
        },
        "Stage": {
          "HostNames": "www.mysite.com,mysite.com,localhost:44389",
          "SiteMapDomain": "www.mysite.com",
          "RuleSet": "Development"
        }
      }
    }
  }
}