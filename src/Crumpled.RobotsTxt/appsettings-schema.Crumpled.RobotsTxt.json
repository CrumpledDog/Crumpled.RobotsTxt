{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Crumpled.RobotsTxt",
  "type": "object",
  "properties": {
    "Crumpled": {
      "$ref": "#/definitions/Crumpled"
    }
  },
  "definitions": {
    "Crumpled": {
      "type": "object",
      "properties": {
        "RobotsTxt": {
          "type": "object",
          "description": "Configuration of robots txt file",
          "properties": {
            "DisableComposer": {
              "type": "boolean",
              "description": "Set to true to disable automatic registration via Composer (for manual registration in Program.cs)",
              "default": false
            },
            "MaxAge": {
              "type": "string",
              "description": "Cache duration for robots.txt responses (TimeSpan format: 'd.hh:mm:ss' or 'hh:mm:ss'). Examples: '1.00:00:00' (1 day), '12:00:00' (12 hours), '00:30:00' (30 minutes)",
              "default": "1.00:00:00",
              "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}$"
            },
            "DefaultRuleset": {
              "type": "string",
              "description": "Name of the RuleSet to use as a fallback for unmatched domains or when no Sites are configured"
            },
            "RuleSets": {
              "type": "object",
              "description": "Named rule sets defining Allow and Disallow rules for different environments",
              "patternProperties": {
                ".*": {
                  "type": "object",
                  "properties": {
                    "IncludeContentSignalInstructions": {
                      "type": "boolean",
                      "description": "Set to true to include Content Signal legal instructions at the top of robots.txt for this ruleset",
                      "default": false
                    },
                    "ContentSignal": {
                      "type": "object",
                      "description": "Content Signals (https://contentsignals.org/) - AI training and content usage permissions. Applied to Allow rules only",
                      "properties": {
                        "AiTrain": {
                          "type": "boolean",
                          "description": "Allow AI Training - training or fine-tuning AI models"
                        },
                        "Search": {
                          "type": "boolean",
                          "description": "Allow Search - building a search index and providing search results"
                        },
                        "AiInput": {
                          "type": "boolean",
                          "description": "Allow AI Input - inputting content into AI models (RAG, grounding, generative AI search)"
                        }
                      },
                      "additionalProperties": false
                    },
                    "Allow": {
                      "type": "object",
                      "patternProperties": {
                        ".*": {
                          "oneOf": [
                            {
                              "type": "array",
                              "items": {
                                "type": "string"
                              },
                              "description": "Simple format: Array of paths for this user agent"
                            },
                            {
                              "type": "object",
                              "properties": {
                                "Paths": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  },
                                  "description": "Array of paths for this user agent"
                                },
                                "ContentSignal": {
                                  "type": "object",
                                  "description": "Path-specific Content Signal for these paths",
                                  "properties": {
                                    "AiTrain": {
                                      "type": "boolean"
                                    },
                                    "Search": {
                                      "type": "boolean"
                                    },
                                    "AiInput": {
                                      "type": "boolean"
                                    }
                                  },
                                  "additionalProperties": false
                                },
                                "CrawlDelay": {
                                  "type": "integer",
                                  "description": "Crawl-delay in seconds for this user agent. Requests crawlers to wait this many seconds between requests",
                                  "minimum": 0
                                }
                              },
                              "required": ["Paths"],
                              "additionalProperties": false,
                              "description": "Complex format: Object with Paths, optional path-specific ContentSignal, and optional CrawlDelay"
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "Paths": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    },
                                    "description": "Array of paths for this path-specific rule"
                                  },
                                  "ContentSignal": {
                                    "type": "object",
                                    "description": "Path-specific Content Signal for these paths",
                                    "properties": {
                                      "AiTrain": {
                                        "type": "boolean"
                                      },
                                      "Search": {
                                        "type": "boolean"
                                      },
                                      "AiInput": {
                                        "type": "boolean"
                                      }
                                    },
                                    "additionalProperties": false
                                  },
                                  "CrawlDelay": {
                                    "type": "integer",
                                    "description": "Crawl-delay in seconds for this user agent. Requests crawlers to wait this many seconds between requests",
                                    "minimum": 0
                                  }
                                },
                                "required": ["Paths"],
                                "additionalProperties": false
                              },
                              "description": "Multiple path-specific rules: Array of objects, each with Paths, optional ContentSignal, and optional CrawlDelay"
                            }
                          ]
                        }
                      },
                      "additionalProperties": false,
                      "description": "Allow rules - key is user agent, value is simple array of paths, complex object, or array of complex objects for path-specific Content-Signals"
                    },
                    "Disallow": {
                      "type": "object",
                      "patternProperties": {
                        ".*": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "additionalProperties": false,
                      "description": "Disallow rules - key is user agent, value is array of paths"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "Sites": {
              "type": "object",
              "description": "Site configurations with hostnames, sitemap domain, and reference to a RuleSet",
              "patternProperties": {
                ".*": {
                  "type": "object",
                  "properties": {
                    "HostNames": {
                      "type": "string",
                      "description": "CSV of hostnames to apply the sitemap domain, e.g. www.mysite.com,mysite.com,localhost:44389"
                    },
                    "SiteMapDomain": {
                      "type": "string",
                      "description": "The domain to be used for sitemap.xml"
                    },
                    "RuleSet": {
                      "type": "string",
                      "description": "The name of the RuleSet to use for this site"
                    }
                  },
                  "required": ["HostNames", "RuleSet"],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}