{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Crumpled.RobotsTxt",
  "type": "object",
  "properties": {
    "Crumpled": {
      "$ref": "#/definitions/Crumpled"
    }
  },
  "definitions": {
    "Crumpled": {
      "type": "object",
      "properties": {
        "RobotsTxt": {
          "type": "object",
          "description": "Configuration of robots txt file",
          "properties": {
            "IsProduction": {
              "type": "boolean",
              "description": "Set to true for live robots txt",
              "default": false
            },
            "SitemapDomain": {
              "type": "string",
              "description": "The domain to be used for sitemap.xml (e.g. https://www.mysite.com/)"
            },
            "Allow": {
              "type": "object",
              "patternProperties": {
                ".*": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "description": "Additional allow rules - key is user agent, value is array of paths"
            },
            "Disallow": {
              "type": "object",
              "patternProperties": {
                ".*": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "description": "Additional disallow rules - key is user agent, value is array of paths"
            },
            "Domains": {
              "type": "object",
              "description": "Multiple domain configurations with separate IsProduction and sitemap settings per domain",
              "patternProperties": {
                ".*": {
                  "type": "object",
                  "properties": {
                    "HostNames": {
                      "type": "string",
                      "description": "CSV of hostnames to apply the sitemap domain, e.g. www.mysite.com,mysite.com,localhost:44389"
                    },
                    "SiteMapDomain": {
                      "type": "string",
                      "description": "The domain to be used for sitemap.xml"
                    },
                    "IsProduction": {
                      "type": "boolean",
                      "description": "Set to true for live robots txt",
                      "default": false
                    }
                  },
                  "required": ["HostNames", "SiteMapDomain"],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}