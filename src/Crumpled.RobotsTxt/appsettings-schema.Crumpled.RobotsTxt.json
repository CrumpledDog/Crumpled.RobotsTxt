{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"title": "Crumpled.RobotsTxt",
	"type": "object",
	"properties": {
		"Crumpled": {
			"$ref": "#/definitions/Crumpled"
		}
	},
	"definitions": {
		"Crumpled": {
			"type": "object",
			"properties": {
				"RobotsTxt": {
					"type": "object",
					"description": "Configuration of robots txt file",
					"properties": {
						"IsProduction": {
							"type": "boolean",
							"description": "Set to true for live robots txt"
						},
						"Allow": {
							"type": "object",
							"description": "Addtional allow rules"
						},
						"Disallow": {
							"type": "object",
							"description": "Addtional disallow rules"
						},
						"SiteMapDomains": {
							"type": "array",
							"description": "Mappings for multiple sites with different domains",
							"items": {
								"type": "object",
								"properties": {
									"HostNames": {
										"type": "string",
										"description": "CSV of hostnames to apply the sitemap domain, e.g. www.mysite.com,mysite.com,localhost:44389"
									},
									"SiteMapDomain": {
										"type": "string",
										"description": "The domain to be used for sitemap.xml"
									}
								}
							}
						}
					}
				}
			}
		}
	},
	"required": [
		"Crumpled"
	]
}