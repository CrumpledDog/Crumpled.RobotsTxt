{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Crumpled.RobotsTxt",
  "type": "object",
  "properties": {
    "Crumpled": {
      "$ref": "#/definitions/Crumpled"
    }
  },
  "definitions": {
    "Crumpled": {
      "type": "object",
      "properties": {
        "RobotsTxt": {
          "type": "object",
          "description": "Configuration of robots txt file",
          "properties": {
            "IsProduction": {
              "type": "boolean",
              "description": "Set to true for live robots txt"
            },
            "Allow": {
              "type": "object",
              "patternProperties": {
                ".*": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "description": "Addtional allow rules"
            },
            "Disallow": {
              "type": "object",
              "patternProperties": {
                ".*": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "description": "Addtional disallow rules"
            },
            "Domains": {
              "type": "object",
              "description": "To control IsProduction per domain, use this collection",
              "patternProperties": {
                ".*": {
                  "type": "object",
                  "properties": {
                    "HostNames": {
                      "type": "string",
                      "description": "CSV of hostnames to apply the sitemap domain, e.g. www.mysite.com,mysite.com,localhost:44389"
                    },
                    "SiteMapDomain": {
                      "type": "string",
                      "description": "The domain to be used for sitemap.xml"
                    },
                    "IsProduction": {
                      "type": "boolean",
                      "description": "Set to true for live robots txt"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "Crumpled"
  ]
}