## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Tt]est[Rr]esults/
artifacts/

# Visual Studio 2015/2017 cache/options directory
.vs/

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Node
node_modules/
dist/

# Compiled Client static web assets - CI rebuilds these (npm run build) before dotnet pack, so
# committing them would just be build-artifact diff noise (hashed chunk filenames churn every build).
/src/Crumpled.PackageTemplate/wwwroot/App_Plugins/

# Generated OpenAPI client - CI regenerates this (npm run generate-client) before building, so
# committing it would just be codegen diff noise, and it can drift out of sync with the actual API
# between regenerations.
/src/Crumpled.PackageTemplate/Client/src/api/

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db
[Dd]esktop.ini

# MSBuild Binary and Structured Log
*.binlog

# Local secrets / workflow overrides
.github/workflows/local/secrets.env

##
## Umbraco CMS (DemoSite)
##
appsettings.Local.json
appsettings-schema.json
appsettings-schema.*.json
umbraco-package-schema.json
/src/Crumpled.PackageTemplate.DemoSite/umbraco/Data/CreatedPackages/
/src/Crumpled.PackageTemplate.DemoSite/umbraco/Data/TEMP/
/src/Crumpled.PackageTemplate.DemoSite/umbraco/Data/*.sqlite.db
/src/Crumpled.PackageTemplate.DemoSite/umbraco/Data/*.sqlite.db-shm
/src/Crumpled.PackageTemplate.DemoSite/umbraco/Data/*.sqlite.db-wal
/src/Crumpled.PackageTemplate.DemoSite/umbraco/Logs/
/src/Crumpled.PackageTemplate.DemoSite/wwwroot/media/

# LiteSpeed/LSCache and node tooling
*.lscache
/node_modules/*
